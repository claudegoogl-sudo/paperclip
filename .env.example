# PostgreSQL connection string. Empty by default — set this to a value that
# uses a password you generated (e.g. `openssl rand -hex 32`). The Docker
# Compose stack in docker/docker-compose.yml refuses to start without an
# explicit POSTGRES_PASSWORD; see doc/DOCKER.md#postgresql-password for the
# recipe. Shape: postgres://USER:PASSWORD@HOST:PORT/DB
# DATABASE_URL=postgres://paperclip:YOUR_PASSWORD@localhost:5432/paperclip
DATABASE_URL=
PORT=3100
SERVE_UI=false
# Required in authenticated mode. Generate one with: openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
